# Use one AI provider, or use manual plans without AI credentials.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Download a Desktop app OAuth client JSON from Google Cloud Console.
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=.credentials/youtube_token.json

# Optional: full executable paths if FFmpeg / FFprobe are not on PATH.
# FFMPEG_BINARY=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_BINARY=C:/ffmpeg/bin/ffprobe.exe
# CAPTION_FONT=Nirmala UI
